<?xml version="1.0"?>
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========== Dimensions (metres, kg) ========== -->
  <xacro:property name="base_length" value="0.6"/>
  <xacro:property name="base_width" value="0.4"/>
  <xacro:property name="base_height" value="0.2"/>
  <xacro:property name="base_mass" value="15.0"/>
  <xacro:property name="ground_clearance" value="0.03"/>

  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_mass" value="1.0"/>

  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_x" value="0.22"/>

  <!-- Height of base_link (centre of the box) above the ground -->
  <xacro:property name="base_z" value="${ground_clearance + base_height / 2}"/>

  <!-- ========== Footprint: on the ground, under the robot centre ========== -->
  <link name="base_footprint"/>

  <!-- ========== Chassis ========== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <inertia ixx="${base_mass / 12.0 * (base_width**2 + base_height**2)}" ixy="0" ixz="0"
               iyy="${base_mass / 12.0 * (base_length**2 + base_height**2)}" iyz="0"
               izz="${base_mass / 12.0 * (base_length**2 + base_width**2)}"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <!-- ========== Drive wheel macro: side = 1 (left) or -1 (right) ========== -->
  <xacro:macro name="drive_wheel" params="name side">
    <link name="${name}_wheel">
      <visual>
        <!-- a cylinder points along Z; roll it 90 deg so it points along Y -->
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass / 12.0 * (3 * wheel_radius**2 + wheel_width**2)}"
                 ixy="0" ixz="0"
                 iyy="${wheel_mass / 12.0 * (3 * wheel_radius**2 + wheel_width**2)}"
                 iyz="0" izz="${wheel_mass / 2.0 * wheel_radius**2}"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <!-- middle of the side, just outside the box, axle at wheel_radius above the ground -->
      <origin xyz="0 ${side * (base_width / 2 + wheel_width / 2)} ${wheel_radius - base_z}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel name="left" side="1"/>
  <xacro:drive_wheel name="right" side="-1"/>

  <!-- ========== Caster macro: position = 1 (front) or -1 (rear) ========== -->
  <xacro:macro name="caster" params="name position">
    <link name="${name}_caster">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="grey">
          <color rgba="0.6 0.6 0.6 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="${0.4 * 0.2 * caster_radius**2}" ixy="0" ixz="0"
                 iyy="${0.4 * 0.2 * caster_radius**2}" iyz="0"
                 izz="${0.4 * 0.2 * caster_radius**2}"/>
      </inertial>
    </link>

    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster"/>
      <!-- the sphere touches the ground: its centre is caster_radius above it -->
      <origin xyz="${position * caster_x} 0 ${caster_radius - base_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster name="front" position="1"/>
  <xacro:caster name="rear" position="-1"/>
  <!-- ========== Cargo deck: plate + low rim, behind the LiDAR ========== -->
  <xacro:property name="deck_length" value="0.48"/>
  <xacro:property name="deck_x" value="-0.05"/>        <!-- shifted back to leave room for the LiDAR -->
  <xacro:property name="plate_thickness" value="0.01"/>
  <xacro:property name="rim_height" value="0.04"/>
  <xacro:property name="rim_thickness" value="0.01"/>

  <link name="cargo_deck">
    <visual>
      <origin xyz="0 0 ${plate_thickness / 2}"/>
      <geometry>
        <box size="${deck_length} ${base_width} ${plate_thickness}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${plate_thickness / 2}"/>
      <geometry>
        <box size="${deck_length} ${base_width} ${plate_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.03"/>
    </inertial>
  </link>

  <joint name="cargo_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cargo_deck"/>
    <!-- sits on top of the box -->
    <origin xyz="${deck_x} 0 ${base_height / 2}"/>
  </joint>
  <!-- one rim wall: size and position relative to the deck -->
  <xacro:macro name="rim" params="name sx sy x y">
    <link name="rim_${name}">
      <visual>
        <geometry>
          <box size="${sx} ${sy} ${rim_height}"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry>
          <box size="${sx} ${sy} ${rim_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="rim_${name}_joint" type="fixed">
      <parent link="cargo_deck"/>
      <child link="rim_${name}"/>
      <origin xyz="${x} ${y} ${plate_thickness + rim_height / 2}"/>
    </joint>
  </xacro:macro>

  <xacro:rim name="front" sx="${rim_thickness}" sy="${base_width}"
             x="${deck_length / 2 - rim_thickness / 2}" y="0"/>
  <xacro:rim name="rear" sx="${rim_thickness}" sy="${base_width}"
             x="${-deck_length / 2 + rim_thickness / 2}" y="0"/>
  <xacro:rim name="left" sx="${deck_length}" sy="${rim_thickness}"
             x="0" y="${base_width / 2 - rim_thickness / 2}"/>
  <xacro:rim name="right" sx="${deck_length}" sy="${rim_thickness}"
             x="0" y="${-base_width / 2 + rim_thickness / 2}"/>

  <!-- ========== LiDAR: on the front of the top, ahead of the cargo deck ========== -->
  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.05"/>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${base_length / 2 - 0.05} 0 ${base_height / 2 + lidar_height / 2}"/>
  </joint>
    <!-- Simulation-only parts (friction, DiffDrive, LiDAR sensor) -->
  <xacro:include filename="amr.gazebo.xacro"/>
</robot>