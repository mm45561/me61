<?xml version="1.0"?>
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    AMR with the look and dimensions of a MiR100.
    Meshes: meshes/mir/ (from DFKI-NI/mir_robot, BSD licence, see meshes/mir/LICENSE).
    Visuals use the meshes; collisions stay simple shapes so physics and Nav2 stay fast.
    Link names are unchanged, so amr.gazebo.xacro, the bridge and Nav2 still work.
  -->

  <xacro:property name="mesh_dir" value="file://$(find amr_description)/meshes/mir"/>

  <!-- ========== Dimensions (metres, kg), measured from the MiR100 meshes ========== -->
  <xacro:property name="base_mass" value="58.0"/>
  <xacro:property name="body_length" value="0.898"/>
  <xacro:property name="body_width" value="0.585"/>
  <xacro:property name="body_bottom" value="0.02"/>      <!-- underside of the body above the floor -->
  <xacro:property name="body_top" value="0.354"/>        <!-- top surface (cargo deck) height -->
  <xacro:property name="body_dx" value="0.037646"/>      <!-- body centre is ahead of the wheel axle -->

  <xacro:property name="wheel_radius" value="0.0625"/>
  <xacro:property name="wheel_width" value="0.032"/>
  <xacro:property name="wheel_dy" value="0.222604"/>     <!-- half the distance between drive wheels -->
  <xacro:property name="wheel_separation" value="${2 * wheel_dy}"/>
  <xacro:property name="wheel_mass" value="1.0"/>

  <xacro:property name="caster_front_x" value="0.341346"/>
  <xacro:property name="caster_rear_x" value="-0.270154"/>
  <xacro:property name="caster_dy" value="0.203"/>
  <xacro:property name="caster_radius" value="${wheel_radius}"/>

  <!-- ========== Footprint: on the ground, under the wheel axle centre ========== -->
  <link name="base_footprint"/>

  <!-- ========== Body: base_link sits on the ground like on a real MiR ========== -->
  <link name="base_link">
    <visual>
      <origin xyz="${body_dx} 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/mir_100_base.stl"/>
      </geometry>
      <material name="mir_grey">
        <color rgba="0.05 0.15 0.40 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${body_dx} 0 ${(body_bottom + body_top) / 2}"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_top - body_bottom}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${body_dx} 0 0.2"/>
      <mass value="${base_mass}"/>
      <inertia ixx="${base_mass / 12.0 * (body_width**2 + body_top**2)}" ixy="0" ixz="0"
               iyy="${base_mass / 12.0 * (body_length**2 + body_top**2)}" iyz="0"
               izz="${base_mass / 12.0 * (body_length**2 + body_width**2)}"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- ========== Drive wheels: side = 1 (left) or -1 (right) ========== -->
  <xacro:macro name="drive_wheel" params="name side">
    <link name="${name}_wheel">
      <visual>
        <geometry>
          <mesh filename="${mesh_dir}/wheel.stl"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="${pi / 2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass / 12.0 * (3 * wheel_radius**2 + wheel_width**2)}"
                 ixy="0" ixz="0"
                 iyy="${wheel_mass / 12.0 * (3 * wheel_radius**2 + wheel_width**2)}"
                 iyz="0" izz="${wheel_mass / 2.0 * wheel_radius**2}"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="0 ${side * wheel_dy} ${wheel_radius}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel name="left" side="1"/>
  <xacro:drive_wheel name="right" side="-1"/>

  <!--
    ========== Casters: one link per axle, each carrying the left and right caster ==========
    A real MiR has four swivel casters. Here they are fixed, frictionless spheres
    (see amr.gazebo.xacro); the meshes only make them look right.
  -->
  <!-- one caster (swivel housing + wheel) drawn at side offset y inside a caster link -->
  <xacro:macro name="caster_visual" params="y">
    <visual>
      <origin xyz="0 ${y} ${caster_radius + 0.094 - 0.0425}" rpy="${24 * pi / 180} 0 ${pi / 2}"/>
      <geometry>
        <mesh filename="${mesh_dir}/caster_wheel_base.stl"/>
      </geometry>
      <material name="mir_grey"/>
    </visual>
    <visual>
      <origin xyz="-0.0382 ${y} ${caster_radius}"/>
      <geometry>
        <mesh filename="${mesh_dir}/wheel.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 ${y} ${caster_radius}"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="caster_pair" params="name x">
    <link name="${name}_caster">
      <xacro:caster_visual y="${caster_dy}"/>
      <xacro:caster_visual y="${-caster_dy}"/>
      <inertial>
        <origin xyz="0 0 ${caster_radius}"/>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster"/>
      <origin xyz="${x} 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster_pair name="front" x="${caster_front_x}"/>
  <xacro:caster_pair name="rear" x="${caster_rear_x}"/>

  <!--
    ========== LiDAR: a SICK scanner on top, at the front edge ==========
    A real MiR has two corner scanners whose scans are merged. One scanner on top
    is simpler to start with and nothing on the robot can block its beam.
  -->
  <xacro:property name="lidar_mount_height" value="0.116"/>   <!-- scanner origin above its base -->

  <link name="lidar_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_dir}/sick_lms-100.stl"/>
      </geometry>
            <material name="sick_red">
        <color rgba="0.85 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.012 0 -0.04"/>
      <geometry>
        <box size="0.126 0.102 0.153"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.1"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${body_dx + body_length / 2 - 0.08} 0 ${body_top + lidar_mount_height}"/>
  </joint>
  <!-- ========== Modern trim: visual only, no collision ========== -->
  <link name="body_trim">
    <!-- light grey top cover: the cargo surface -->
    <visual>
      <origin xyz="${body_dx} 0 ${body_top + 0.004}"/>
      <geometry>
        <box size="${body_length - 0.03} ${body_width - 0.03} 0.008"/>
      </geometry>
      <material name="cover_grey">
        <color rgba="0.85 0.87 0.90 1.0"/>
      </material>
    </visual>
    <!-- cyan LED strip all around, just below the top -->
    <visual>
      <origin xyz="${body_dx} 0 ${body_top - 0.05}"/>
      <geometry>
        <box size="${body_length + 0.006} ${body_width + 0.006} 0.015"/>
      </geometry>
      <material name="led_cyan">
        <color rgba="0.0 0.85 1.0 1.0"/>
      </material>
    </visual>
    <!-- black rubber bumper around the bottom -->
    <visual>
      <origin xyz="${body_dx} 0 ${body_bottom + 0.03}"/>
      <geometry>
        <box size="${body_length + 0.012} ${body_width + 0.012} 0.06"/>
      </geometry>
      <material name="bumper_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <!-- a tiny mass, otherwise Gazebo drops the link and its visuals -->
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="body_trim_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_trim"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Simulation-only parts (friction, DiffDrive, LiDAR sensor) -->
  <xacro:include filename="amr.gazebo.xacro"/>

</robot>
